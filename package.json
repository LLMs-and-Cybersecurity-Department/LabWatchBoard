{
  "name": "ecmwf-pboard",
  "version": "1.0.0",
  "description": "面向公众的多模式天气与全球地震信息看板",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "crawl:ecmwf": "node scripts/crawl-ecmwf-catalogue.mjs",
    "data:jma-sites": "node scripts/extract-jma-seismic-sites.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check": "pnpm check:ui && pnpm check:catalogue && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "d3-contour": "^4.0.2",
    "d3-dsv": "^3.0.1",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "5.9.3",
    "gifenc": "^1.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.50.8",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "4.2.1",
    "recharts": "3.9.2",
    "seisplotjs": "^3.2.5",
    "topojson-client": "^3.1.0",
    "vite": "^6.0.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@esbuild/darwin-x64": "0.25.12",
    "@rollup/rollup-darwin-x64": "^4.62.2",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
