{
  "name": "ecmwf-pboard",
  "version": "1.0.0",
  "productName": "LabWatch",
  "description": "面向公众的多模式天气与全球地震信息看板",
  "author": "BasyaCatX",
  "homepage": "https://github.com/BasyaCatX/ecmwf-pBoard",
  "desktopName": "labwatch.desktop",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:live": "node scripts/build-live.mjs",
    "build:desktop-runtime": "node scripts/build-desktop-runtime.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "pnpm build && pnpm build:desktop-runtime && electron .",
    "dist:mac": "pnpm build && pnpm build:desktop-runtime && electron-builder --mac dmg pkg",
    "dist:linux": "pnpm build && pnpm build:desktop-runtime && electron-builder --linux AppImage deb rpm --x64",
    "dist:windows": "bash scripts/package-windows-x64.sh all",
    "dist:windows:portable": "bash scripts/package-windows-x64.sh portable",
    "verify:windows-release": "node scripts/verify-windows-release.mjs",
    "mobile:add": "cap add android",
    "mobile:sync": "pnpm build && cap sync android",
    "dist:android:debug": "pnpm mobile:sync && cd android && ./gradlew assembleDebug",
    "dist:android": "node scripts/build-android-release.mjs",
    "verify:release": "node scripts/verify-release-inputs.mjs",
    "crawl:ecmwf": "node scripts/crawl-ecmwf-catalogue.mjs",
    "data:jma-sites": "node scripts/extract-jma-seismic-sites.mjs",
    "data:global-faults": "node scripts/build-global-faults.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check": "pnpm check:ui && pnpm check:catalogue && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.2.0",
    "cn-atlas": "0.1.2",
    "d3-contour": "^4.0.2",
    "d3-dsv": "^3.0.1",
    "d3-geo": "^3.1.1",
    "fast-xml-parser": "5.9.3",
    "gifenc": "^1.0.3",
    "https-proxy-agent": "7.0.6",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.50.8",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "4.2.1",
    "recharts": "3.9.2",
    "seisplotjs": "^3.2.5",
    "taiwan-atlas": "2021.9.20",
    "topojson-client": "^3.1.0",
    "undici": "7.28.0",
    "vite": "^6.0.3",
    "world-atlas": "^2.0.2",
    "ws": "8.18.3",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@electron/fuses": "2.1.3",
    "@esbuild/darwin-x64": "0.25.12",
    "@rollup/rollup-darwin-x64": "^4.62.2",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "terser": "5.49.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
