# CWA 一般会员即可申请：
# https://opendata.cwa.gov.tw/about/application/general
# 登录后在「会员资讯 → API 授权码」取得；只由本地服务端读取。
CWA_API_TOKEN=

# 国家地震科学数据中心/NSTI 官方数据页专用 HTTP/HTTPS 出口。
NSTI_HTTP_PROXY_URL=http://127.0.0.1:7893

# CENC 产品页面与 FAN Studio CENC WebSocket 的服务端出口。只对 CENC 请求生效，不改系统代理/TUN。
# macOS 上若本机 Clash/兼容代理监听 7893，可使用：
CENC_HTTP_PROXY_URL=http://127.0.0.1:7893
# 如实时 WebSocket 需要使用不同的 HTTP/mixed 代理，可单独覆盖：
CENC_WEBSOCKET_PROXY_URL=

# FAN Studio 新 CENC 实时烈度源要求 appId + key 服务端鉴权。
# 申请地址：https://api.fanstudio.tech/dev-platform/
FANSTUDIO_APP_ID=
FANSTUDIO_API_KEY=

# 下面两组不是公开通用 API Key。仅在运营方明确授权 JSON/CAP Feed 后配置；
# 不要把网页地址或 GlobalQuake 客户端端口当成 Feed URL。
EARLY_EST_FEED_URL=
EARLY_EST_FEED_TOKEN=
GLOBALQUAKE_FEED_URL=
GLOBALQUAKE_FEED_TOKEN=
# 若使用自建 HTTPS 转发服务（该服务需接收 ?url=... 并返回上游响应），
# 则留空 CENC_HTTP_PROXY_URL 后配置：
CENC_EGRESS_PROXY_URL=
CENC_PRODUCT_TIMEOUT_MS=18000
CENC_PRODUCT_CACHE_TTL_MS=300000
